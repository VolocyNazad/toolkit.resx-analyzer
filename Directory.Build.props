<Project>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- The strict audit in CI promotes a missing XML comment on a public member to an error. -->
		<WarningsAsErrors Condition="'$(EnforcePublicApiDocumentation)' == 'true'">$(WarningsAsErrors);CS1591</WarningsAsErrors>
	</PropertyGroup>
	<!-- MinVer properties -->
	<PropertyGroup>
		<MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
		<MinVerAutoIncrement>minor</MinVerAutoIncrement>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev.0</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>
</Project>
